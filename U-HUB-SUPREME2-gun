-- [[ ระบบเลือกเป้าอัจฉริยะ – หาคนในแมพ ]]
local function GetAdvancedSmartTarget()
    local targetPart = nil
    local shortestDist = math.huge
    local visualState = nil

    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") or not myChar:FindFirstChild("Humanoid") then
        return nil, nil
    end
    local myRoot = myChar.HumanoidRootPart

    for _, v in pairs(Players:GetPlayers()) do
        pcall(function()
            if v ~= LocalPlayer and v and v.Character then
                local char = v.Character
                local isWL = false
                local playerName = v.Name
                for _, n in pairs(_G.U_HUB_CORE.Whitelist or {}) do
                    if n == playerName then isWL = true; break end
                end

                if not isWL then
                    local humanoid = char:FindFirstChildOfClass("Humanoid")
                    local rootPart = char:FindFirstChild("HumanoidRootPart")

                    if humanoid and humanoid.Health > 0 and rootPart then
                        -- กันคนเพิ่งเกิด 1 วินาที
                        if not PlayerSpawnTimes[v] then
                            PlayerSpawnTimes[v] = tick()
                        end
                        local timeElapsed = tick() - PlayerSpawnTimes[v]
                        local isImmune = timeElapsed < 1.0

                        if not isImmune then
                            local aimPartName = _G.U_HUB_CORE.AimPart or "Head"
                            if _G.U_HUB_CORE.AiTargetMode == "สุ่มล็อกเป้าจะสุ่มล็อกหัวและตัว" or _G.U_HUB_CORE.AiTargetMode == "สุ่มล็อกเป้า" then
                                local randomRoll = math.random(1, 100)
                                if randomRoll <= 60 then
                                    aimPartName = "Head"
                                else
                                    aimPartName = "HumanoidRootPart"
                                end
                            end

                            local Part = char:FindFirstChild(aimPartName) or char:FindFirstChild("Head") or rootPart

                            if Part then
                                local Mag = (myRoot.Position - Part.Position).Magnitude
                                local maxDist = _G.U_HUB_CORE.AiWalkRadius or 8000

                                if Mag <= maxDist then
                                    local RayParams = RaycastParams.new()
                                    RayParams.FilterType = Enum.RaycastFilterType.Exclude
                                    RayParams.FilterDescendantsInstances = {myChar, Camera}
                                    local Result = workspace:Raycast(Camera.CFrame.Position, (Part.Position - Camera.CFrame.Position), RayParams)

                                    local hasLoS = (Result == nil or Result.Instance:IsDescendantOf(char))
                                    local mode = _G.U_HUB_CORE.AiTargetMode or ""

                                    local isValidTarget = false
                                    if mode:find("ทะลุ") then
                                        isValidTarget = true
                                    else
                                        if hasLoS then isValidTarget = true end
                                    end

                                    if isValidTarget then
                                        if Mag < shortestDist then
                                            shortestDist = Mag
                                            targetPart = Part
                                            local _, OnScreen = Camera:WorldToViewportPoint(Part.Position)
                                            visualState = {
                                                myHealth = humanoid.Health,
                                                targetDistance = math.floor(Mag),
                                                targetOnScreen = OnScreen,
                                                hasLineOfSight = hasLoS
                                            }
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end)
    end
    return targetPart, visualState
end

-- หาคนใกล้ที่สุดในแมพ (ไม่สน LOS) สำหรับเดินไล่หา
local function GetRoamingHuntTarget()
    local bestPart = nil
    local shortestDist = math.huge

    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return nil end
    local myRoot = myChar.HumanoidRootPart

    for _, v in pairs(Players:GetPlayers()) do
        pcall(function()
            if v ~= LocalPlayer and v and v.Character then
                local char = v.Character
                local isWL = false
                local playerName = v.Name
                for _, n in pairs(_G.U_HUB_CORE.Whitelist or {}) do
                    if n == playerName then isWL = true; break end
                end

                if not isWL then
                    local humanoid = char:FindFirstChildOfClass("Humanoid")
                    local rootPart = char:FindFirstChild("HumanoidRootPart")

                    if humanoid and humanoid.Health > 0 and rootPart then
                        if not PlayerSpawnTimes[v] then
                            PlayerSpawnTimes[v] = tick()
                        end
                        if (tick() - PlayerSpawnTimes[v]) < 1.0 then return end

                        local Mag = (myRoot.Position - rootPart.Position).Magnitude
                        if Mag < shortestDist then
                            shortestDist = Mag
                            bestPart = rootPart
                        end
                    end
                end
            end
        end)
    end
    return bestPart
end

local function GetAnyPlayerToHunt()
