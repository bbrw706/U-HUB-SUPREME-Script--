RunService.RenderStepped:Connect(function(dt)
    local Center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    -- FOV
    if _G.FOV_CircleFrame then
        local isLockActive = _G.U_HUB_CORE.AutoLockNoClick
        _G.FOV_CircleFrame.Visible = _G.U_HUB_CORE.FovEnabled and isLockActive
        _G.FOV_CircleFrame.Size = UDim2.fromOffset(_G.U_HUB_CORE.FovRadius * 2, _G.U_HUB_CORE.FovRadius * 2)
        _G.FOV_CircleFrame.Position = UDim2.fromOffset(Center.X, Center.Y)
        if _G.FOV_Stroke then
            _G.FOV_Stroke.Color = _G.U_HUB_CORE.PovColor
        end
    end

    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") or not myChar:FindFirstChildOfClass("Humanoid") then
        return
    end
    local myRoot = myChar.HumanoidRootPart
    local humanoid = myChar:FindFirstChildOfClass("Humanoid")

    local aiOn = _G.U_HUB_CORE.FollowClosestEnabled or _G.U_HUB_CORE.AutoFarmEnabled
    local lockOnly = _G.U_HUB_CORE.AutoLockNoClick and not aiOn

    -- โหมดล็อกอย่างเดียว
    if lockOnly then
        local LockTarget = GetTarget(Center)
        if LockTarget then
            CurrentHuntTarget = LockTarget
            local jitter = Vector3.new(math.random(-8, 8) / 100, math.random(-8, 8) / 100, 0)
            local TargetCF = CFrame.new(Camera.CFrame.Position, LockTarget.Position + jitter)
            Camera.CFrame = Camera.CFrame:Lerp(TargetCF, _G.U_HUB_CORE.Sensitivity or 0.05)

            local screenPos, onScreen = Camera:WorldToViewportPoint(LockTarget.Position)
            if onScreen then
                local distCenter = (Vector2.new(screenPos.X, screenPos.Y) - Center).Magnitude
                if distCenter < 18 then
                    if not HasLockedAndWaiting then
                        HasLockedAndWaiting = true
                        LockTimer = tick()
                    elseif tick() - LockTimer >= 0.18 and tick() - LastShootTime > 0.12 then
                        LastShootTime = tick()
                        SafeHumanClick()
                    end
                else
                    HasLockedAndWaiting = false
                end
            else
                HasLockedAndWaiting = false
            end
        else
            HasLockedAndWaiting = false
        end
        return
    end

    if not aiOn then
        HasLockedAndWaiting = false
        return
    end

    -- ===== AI เดินหาคนในแมพจริง ๆ =====
    -- ลำดับ: 1) เป้าที่ล็อกได้  2) คนใกล้สุดในแมพ (ไม่สนกำแพง)  3) เดินวนหา
    local LockTarget, visualState = GetAdvancedSmartTarget()
    local desiredPos = nil
    local hasCombatTarget = false

    if LockTarget then
        -- เจอเป้าที่ล็อกได้ → เข้าใกล้แล้วยิง
        hasCombatTarget = true
        desiredPos = LockTarget.Position
        CurrentHuntTarget = LockTarget

        local jitter = Vector3.new(math.random(-10, 10) / 100, math.random(-10, 10) / 100, 0)
        local TargetCF = CFrame.new(Camera.CFrame.Position, LockTarget.Position + jitter)
        Camera.CFrame = Camera.CFrame:Lerp(TargetCF, _G.U_HUB_CORE.AiSmoothness or 0.45)

        local screenPos, onScreen = Camera:WorldToViewportPoint(LockTarget.Position)
        if onScreen then
            local distCenter = (Vector2.new(screenPos.X, screenPos.Y) - Center).Magnitude
            if distCenter < 28 then
                if not HasLockedAndWaiting then
                    HasLockedAndWaiting = true
                    LockTimer = tick()
                elseif tick() - LockTimer >= 0.15 and tick() - LastShootTime > 0.12 then
                    LastShootTime = tick()
                    SafeHumanClick() -- ส่งไปเซิร์ฟว่าคลิกซ้าย
                end
            else
                HasLockedAndWaiting = false
            end
        else
            -- เป้าอยู่หลังกำแพง/นอกจอ → ยังเดินเข้าไปหา
            HasLockedAndWaiting = false
        end
    else
        HasLockedAndWaiting = false

        -- ไม่มีเป้าล็อก → หาคนใกล้สุดในแมพแล้วเดินตรงไปหา
        local hunt = GetRoamingHuntTarget()
        if hunt and hunt.Parent then
            desiredPos = hunt.Position
            CurrentHuntTarget = hunt

            -- หันกล้องไปทางคนที่กำลังไล่ (แม้ยังยิงไม่ได้)
            local lookCF = CFrame.new(Camera.CFrame.Position, hunt.Position + Vector3.new(0, 1.5, 0))
            Camera.CFrame = Camera.CFrame:Lerp(lookCF, 0.12)

            -- ถ้าใกล้พอและมี LOS ให้ลองยิงด้วย
            local distHunt = (myRoot.Position - hunt.Position).Magnitude
            if distHunt < (_G.U_HUB_CORE.EngageDistance or 16) + 8 then
                local RayParams = RaycastParams.new()
                RayParams.FilterType = Enum.RaycastFilterType.Exclude
                RayParams.FilterDescendantsInstances = {myChar, Camera}
                local Result = workspace:Raycast(Camera.CFrame.Position, (hunt.Position - Camera.CFrame.Position), RayParams)
                local hasLoS = (Result == nil or (Result.Instance and Result.Instance:IsDescendantOf(hunt.Parent)))
                if hasLoS and tick() - LastShootTime > 0.18 then
                    LastShootTime = tick()
                    SafeHumanClick()
                end
            end
        else
            -- ไม่มีผู้เล่นอื่นในแมพ → เดินวนสำรวจกว้าง ๆ
            RoamAngle = RoamAngle + 0.55 * dt
            local radius = _G.U_HUB_CORE.HuntMapRadius or 450
            -- ขยายรัศมีทีละน้อยเพื่อคลุมแมพ
            local expand = 1 + (math.sin(tick() * 0.15) * 0.35)
            desiredPos = myRoot.Position + Vector3.new(
                math.cos(RoamAngle) * radius * expand,
                0,
                math.sin(RoamAngle) * radius * expand
            )
            CurrentHuntTarget = nil
        end
    end

    -- ตรวจติดขัด → กระโดด + หันข้าง
    if (myRoot.Position - LastPos).Magnitude < 0.2 then
        StuckTimer = StuckTimer + dt
        if StuckTimer > 0.28 then
            AvoidSide = -AvoidSide
            humanoid.Jump = true
            local side = Vector3.new(-myRoot.CFrame.LookVector.Z, 0, myRoot.CFrame.LookVector.X) * AvoidSide
            desiredPos = myRoot.Position + side * 22 + myRoot.CFrame.LookVector * 6
            StuckTimer = 0
        end
    else
        StuckTimer = 0
    end
    LastPos = myRoot.Position

    -- สั่งเดินตลอด (สำคัญ: ต้องมี desiredPos ทุกเฟรมที่ AI เปิด)
    if desiredPos then
        ImprovedMoveTo(humanoid, myRoot, desiredPos, hasCombatTarget)
    else
        -- fallback เดินหน้าตรง
        humanoid:Move(myRoot.CFrame.LookVector * humanoid.WalkSpeed, false)
    end
end)

