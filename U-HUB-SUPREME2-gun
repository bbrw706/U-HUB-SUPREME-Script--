-- ระบบตรวจสอบและยิงรีโมท Play พร้อมระบบคูลดาวน์ 4 วินาทีซ้ำหากยังไม่ออก
task.spawn(function()
    local lastFireTick = 0
    while true do
        task.wait(0.2)
        local isEnabled = _G.U_HUB_CORE.AutoRespawnPlay or _G.U_HUB_CORE.AutoFarmEnabled
        if isEnabled then
            pcall(function()
                local char = LocalPlayer.Character
                local inLobbyOrDead = false
                
                if not char or not char:FindFirstChild("Humanoid") or not char:FindFirstChild("HumanoidRootPart") then
                    inLobbyOrDead = true
                else
                    local humanoid = char.Humanoid
                    local root = char.HumanoidRootPart
                    if humanoid.Health <= 0 or root.Position.Y < -400 then
                        inLobbyOrDead = true
                    end
                end

                local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
                if playerGui and not inLobbyOrDead then
                    for _, gui in pairs(playerGui:GetChildren()) do
                        if gui:IsA("ScreenGui") and gui.Enabled then
                            local nameLower = gui.Name:lower()
                            if nameLower:find("lobby") or nameLower:find("menu") or nameLower:find("spawn") or nameLower:find("main") or nameLower:find("home") or nameLower:find("team") then
                                for _, descendant in pairs(gui:GetDescendants()) do
                                    if descendant:IsA("TextButton") or descendant:IsA("ImageButton") then
                                        local btnText = (descendant.Name .. (descendant:IsA("TextButton") and descendant.Text or "")):lower()
                                        if btnText:find("play") or btnText:find("start") or btnText:find("spawn") or btnText:find("deploy") then
                                            if descendant.Visible then
                                                inLobbyOrDead = true
                                                break
                                            end
                                        end
                                    end
                                end
                            end
                        end
                        if inLobbyOrDead then break end
                    end
                end

                if inLobbyOrDead then
                    local currentTick = tick()
                    if currentTick - lastFireTick >= 4.0 then
                        lastFireTick = currentTick
                        task.wait(_G.U_HUB_CORE.RespawnDelay)
                        FirePlayRemote()
                    end
                else
                    lastFireTick = 0
                end
            end)
        else
            lastFireTick = 0
        end
    end
end)

