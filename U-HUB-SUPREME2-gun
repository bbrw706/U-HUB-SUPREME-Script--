-- IMPROVED MOVE: หลบของ + ไม่พุ่งชน + เดินหาคนในแมพ
-- ============================================================
local function ImprovedMoveTo(humanoid, root, desiredPos, hasCombatTarget)
    if not humanoid or not root or not desiredPos then return end

    local flatTarget = Vector3.new(desiredPos.X, root.Position.Y, desiredPos.Z)
    local toTarget = flatTarget - root.Position
    local dist = toTarget.Magnitude
    if dist < 0.4 then return end

    local moveDir = toTarget.Unit
    local engage = _G.U_HUB_CORE.EngageDistance or 16
    local tooClose = _G.U_HUB_CORE.TooCloseDistance or 9

    -- ถ้ามีเป้าต่อสู้: ไม่เดินเข้าชิด
    if hasCombatTarget then
        if dist < tooClose then
            local back = -moveDir
            local side = Vector3.new(-moveDir.Z, 0, moveDir.X) * ((math.sin(tick() * 3.2) > 0) and 1 or -1)
            moveDir = (back * 0.75 + side * 1.0).Unit
        elseif dist < engage then
            local side = Vector3.new(-moveDir.Z, 0, moveDir.X)
            local orbit = side * math.sin(tick() * 2.6)
            local slightBack = -moveDir * 0.12
            moveDir = (orbit + slightBack).Unit
        end
    end

    -- หลบกำแพง / ของ (raycast หลายทิศ)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {LocalPlayer.Character, Camera}

    local function ray(dir, len)
        return workspace:Raycast(root.Position + Vector3.new(0, 1.6, 0), dir.Unit * (len or 9), params)
    end

    local hitFront = ray(moveDir, 11)
    local hitFL = ray((CFrame.Angles(0, math.rad(-32), 0) * moveDir), 9)
    local hitFR = ray((CFrame.Angles(0, math.rad(32), 0) * moveDir), 9)
    local hitL = ray((CFrame.Angles(0, math.rad(-65), 0) * moveDir), 8)
    local hitR = ray((CFrame.Angles(0, math.rad(65), 0) * moveDir), 8)

    if hitFront or hitFL or hitFR then
        local leftScore = (hitL and 0 or 2) + (hitFL and 0 or 1)
        local rightScore = (hitR and 0 or 2) + (hitFR and 0 or 1)

        if leftScore > rightScore then
            moveDir = (CFrame.Angles(0, math.rad(-50), 0) * moveDir).Unit
        elseif rightScore > leftScore then
            moveDir = (CFrame.Angles(0, math.rad(50), 0) * moveDir).Unit
        else
            moveDir = -moveDir
            humanoid.Jump = true
        end

        if hitFront and hitFront.Distance < 5.5 then
            humanoid.Jump = true
        end
    end

    -- เดิน (รองรับ PC + มือถือ)
    local speed = humanoid.WalkSpeed
    humanoid:Move(moveDir * speed, false)
end

