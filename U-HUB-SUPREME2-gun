        end
    end
end)

local LastShootTimeSafe = 0
local HasLockedAndWaitingSafe = false
local LockTimerSafe = 0
local RoamAngleSafe = 0
local LastPosSafe = Vector3.new(0,0,0)
local StuckTimerSafe = 0
local AvoidSideOffsetSafe = 1

RunService.RenderStepped:Connect(function(dt)
    if not _G.U_HUB_CORE.FollowClosestEnabled then 
        HasLockedAndWaitingSafe = false
        return 
    end

    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("Humanoid") or not character:FindFirstChild("HumanoidRootPart") then return end

    local humanoid = character.Humanoid
    local root = character.HumanoidRootPart
    
    local LockTarget, _ = GetAdvancedSmartTarget()
    local rawDestination = nil

    if LockTarget then
        rawDestination = LockTarget.Position
    else
        local huntTarget = GetRoamingHuntTarget()
        if huntTarget then
            rawDestination = huntTarget.Position
        else
            RoamAngleSafe = RoamAngleSafe + 0.5 * dt
            local mapScanRadius = 300
            local offset = Vector3.new(math.cos(RoamAngleSafe) * mapScanRadius, 0, math.sin(RoamAngleSafe) * mapScanRadius)
            rawDestination = root.Position + offset
        end
    end

    local finalDestination = rawDestination
    if rawDestination then
        local moveDir = (Vector3.new(rawDestination.X, root.Position.Y, rawDestination.Z) - root.Position)
        local distanceToTarget = moveDir.Magnitude
        if distanceToTarget > 1 then
            moveDir = moveDir.Unit
            
            local wallParams = RaycastParams.new()
            wallParams.FilterType = Enum.RaycastFilterType.Exclude
            wallParams.FilterDescendantsInstances = {character, Camera}
            
            local wallCheck = workspace:Raycast(root.Position, moveDir * 6, wallParams)
            if wallCheck then
                local perpendicular = Vector3.new(-moveDir.Z, 0, moveDir.X) * AvoidSideOffsetSafe
                finalDestination = root.Position + (moveDir * 3) + (perpendicular * 10)
                humanoid.Jump = true
            end
        end
        humanoid:MoveTo(finalDestination)
    end

    if (root.Position - LastPosSafe).Magnitude < 0.2 then
        StuckTimerSafe = StuckTimerSafe + dt
        if StuckTimerSafe > 0.25 then
            AvoidSideOffsetSafe = AvoidSideOffsetSafe * -1
            humanoid.Jump = true
            StuckTimerSafe = 0
        end
    else
        StuckTimerSafe = 0
    end
    LastPosSafe = root.Position

    if LockTarget then
        local jitter = Vector3.new(math.random(-10, 10)/100, math.random(-10, 10)/100, 0)
        local TargetCF = CFrame.new(Camera.CFrame.Position, LockTarget.Position + jitter)
        
        local currentSens = _G.U_HUB_CORE.AiSmoothness or 0.45
        Camera.CFrame = Camera.CFrame:Lerp(TargetCF, currentSens)

        local _, onScreen = Camera:WorldToViewportPoint(LockTarget.Position)
        if onScreen then
            local screenPos = Camera:WorldToViewportPoint(LockTarget.Position)
            local Center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
            local distanceToCenter = (Vector2.new(screenPos.X, screenPos.Y) - Center).Magnitude

            if distanceToCenter < 25 then
                if not HasLockedAndWaitingSafe then
                    HasLockedAndWaitingSafe = true
                    LockTimerSafe = tick()
                else
                    if tick() - LockTimerSafe >= 0.2 then
                        if tick() - LastShootTimeSafe > 0.15 then
                            LastShootTimeSafe = tick()
                            pcall(function()
                                local tool = character:FindFirstChildOfClass("Tool")
                                if tool then tool:Activate() end
                            end)
                            if mouse1click then pcall(mouse1click) end
                        end
                    end
                end
            else
                HasLockedAndWaitingSafe = false
            end
        else
            HasLockedAndWaitingSafe = false
        end
    else
        HasLockedAndWaitingSafe = false
    end
end)

