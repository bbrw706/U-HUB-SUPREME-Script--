                                    end
                                end
                            end
                        end
                        if inLobbyOrDead then break end
                    end
                end

                if inLobbyOrDead then
                    local currentTick = tick()
                    if currentTick - lastFireTickFollow >= 4.0 then
                        lastFireTickFollow = currentTick
                        task.wait(_G.U_HUB_CORE.RespawnDelay or 0.5)
                        pcall(function()
