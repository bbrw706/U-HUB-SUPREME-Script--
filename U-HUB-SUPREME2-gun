local function AskQwenAI(visualSceneState)
    local apiKey = _G.U_HUB_CORE.GroqApiKey
    if apiKey == "" or apiKey == nil or IsRequestingAI then return end
    IsRequestingAI = true

    task.spawn(function()
        local httpReq = (syn and syn.request) or (http and http.request) or request or HttpService.RequestAsync
        if not httpReq then IsRequestingAI = false; return end

        local url = "https://api.groq.com/openai/v1/chat/completions"
        local headers = {
            ["Authorization"] = "Bearer " .. apiKey,
            ["Content-Type"] = "application/json"
        }

        local promptSystem = [[
You are an advanced stealthy FPS Gamer AI.
Analyze distance and visibility, choose tactical behavior:
- "CHARGE" (Standard push)
- "FLANK" (Side movement)
- "JUMP_SHOOT" (Tactical hop)
- "RETREAT" (Low health fallback)

Respond ONLY with JSON: {"tactic": "CHOSEN_TACTIC"}
]]

        local bodyData = {
            model = "qwen-2.5-72b-instruct",
            messages = {
                { role = "system", content = promptSystem },
                { role = "user", content = HttpService:JSONEncode(visualSceneState) }
            },
            temperature = 0.2,
            response_format = { type = "json_object" }
        }

        local success, response = pcall(function()
            return httpReq({
                Url = url,
                Method = "POST",
                Headers = headers,
                Body = HttpService:JSONEncode(bodyData)
            })
        end)

        if success and response and response.StatusCode == 200 then
            local data = HttpService:JSONDecode(response.Body)
            if data and data.choices and data.choices[1] then
                local aiResponse = HttpService:JSONDecode(data.choices[1].message.content)
                if aiResponse and aiResponse.tactic then
                    CurrentTactic = aiResponse.tactic
                end
            end
        end

        IsRequestingAI = false
    end)
end

local LastShootTime = 0
local HasLockedAndWaiting = false
local LockTimer = 0

-- ฟังก์ชันคลิกซ้ายสั่งยิงจริง 100% ทั้งคอมและมือถือ
local function SafeHumanClick()
    pcall(function()
        if mouse1click then
            mouse1click()
        elseif pressmouse1 then
            pressmouse1()
        end
    end)
end

-- [รวมลูป AI Bot และระบบเดินอัจฉริยะเข้าด้วยกันอย่างสมบูรณ์]
local LastPosition = Vector3.new(0,0,0)
local StuckTimer = 0
local RoamAngle = 0
local SmoothVelocity = Vector3.new(0,0,0)

RunService.RenderStepped:Connect(function(dt)
    local Center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    
    if _G.FOV_CircleFrame then
        local isLockActive = _G.U_HUB_CORE.AutoLockNoClick
        _G.FOV_CircleFrame.Visible = _G.U_HUB_CORE.FovEnabled and isLockActive
        _G.FOV_CircleFrame.Size = UDim2.fromOffset(_G.U_HUB_CORE.FovRadius * 2, _G.U_HUB_CORE.FovRadius * 2)
        _G.FOV_CircleFrame.Position = UDim2.fromOffset(Center.X, Center.Y)
        _G.FOV_Stroke.Color = _G.U_HUB_CORE.PovColor
    end

    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") or not myChar:FindFirstChildOfClass("Humanoid") then
        return
    end
    local myRoot = myChar.HumanoidRootPart
    local humanoid = myChar:FindFirstChildOfClass("Humanoid")

    -- ตรวจสอบว่าเปิดระบบ AI Bot หรือไม่ ถ้าไม่เปิดให้ข้ามการควบคุมการเดินของ AI ไป
    if not _G.U_HUB_CORE.AutoFarmEnabled then
        local LockTarget = nil
        if _G.U_HUB_CORE.AutoLockNoClick then
            LockTarget, _ = GetTarget(Center)
        end
        if LockTarget then
            local jitter = Vector3.new(math.random(-10, 10) / 100, math.random(-10, 10) / 100, 0)
            local TargetCF = CFrame.new(Camera.CFrame.Position, LockTarget.Position + jitter)
            Camera.CFrame = Camera.CFrame:Lerp(TargetCF, _G.U_HUB_CORE.Sensitivity)
        end
        return
    end

    -- ระบบการทำงานเมื่อเปิด AI Bot (เดินหาเป้าหมายและเคลื่อนที่อัตโนมัติ)
    local autoTargetPart, autoState = GetClosestTargetAuto()
    local LockTarget = nil
    local destinationPos = nil

    if autoTargetPart then
        LockTarget = autoTargetPart
        local targetRoot = autoTargetPart.Parent:FindFirstChild("HumanoidRootPart") or autoTargetPart
        destinationPos = targetRoot.Position

        if autoState and autoState.hasLineOfSight then
            if not HasLockedAndWaiting then
                HasLockedAndWaiting = true
                LockTimer = tick()
            else
                if tick() - LockTimer >= 0.2 then
                    if tick() - LastShootTime > 0.15 then
                        LastShootTime = tick()
                        SafeHumanClick()
                    end
                end
            end
        else
            HasLockedAndWaiting = false
        end
    else
        HasLockedAndWaiting = false
        local huntTarget = GetAnyPlayerToHunt()
        if huntTarget then
            destinationPos = huntTarget.Position
        else
            RoamAngle = RoamAngle + 0.5 * dt
            local mapScanRadius = 500
            local offset = Vector3.new(math.cos(RoamAngle) * mapScanRadius, 0, math.sin(RoamAngle) * mapScanRadius)
            destinationPos = myRoot.Position + offset
        end
    end

    -- ล็อกเป้ากล้องของ AI Bot
    if LockTarget then
        local jitter = Vector3.new(math.random(-10, 10) / 100, math.random(-10, 10) / 100, 0)
        local TargetCF = CFrame.new(Camera.CFrame.Position, LockTarget.Position + jitter)
        Camera.CFrame = Camera.CFrame:Lerp(TargetCF, _G.U_HUB_CORE.AiSmoothness)
    end

    -- ระบบป้องกันการติดทางตันและสิ่งกีดขวาง
    if (myRoot.Position - LastPosition).Magnitude < 0.2 then
        StuckTimer = StuckTimer + dt
        if StuckTimer > 0.3 then
            humanoid.Jump = true
            destinationPos = myRoot.Position + Vector3.new(math.random(-50, 50), 0, math.random(-50, 50))
            StuckTimer = 0
        end
    else
        StuckTimer = 0
    end
    LastPosition = myRoot.Position

    -- สั่งเดินและหลบหลีกกำแพงอัตโนมัติ
    if destinationPos then
        local moveDir = (destinationPos - myRoot.Position)
        moveDir = Vector3.new(moveDir.X, 0, moveDir.Z)
        
        if moveDir.Magnitude > 0.1 then
            moveDir = moveDir.Unit
            local rayParams = RaycastParams.new()
            rayParams.FilterType = Enum.RaycastFilterType.Exclude
            rayParams.FilterDescendantsInstances = {myChar, Camera}

            local checkDist = 8
            local hitCenter = workspace:Raycast(myRoot.Position, moveDir * checkDist, rayParams)
            local leftDir = CFrame.Angles(0, math.rad(-55), 0) * moveDir
            local hitLeft = workspace:Raycast(myRoot.Position, leftDir * checkDist, rayParams)
            local rightDir = CFrame.Angles(0, math.rad(55), 0) * moveDir
            local hitRight = workspace:Raycast(myRoot.Position, rightDir * checkDist, rayParams)

            if hitCenter then
                humanoid.Jump = true
                if not hitLeft then
                    moveDir = leftDir
                elseif not hitRight then
                    moveDir = rightDir
                else
                    moveDir = -moveDir
                end
            end

            SmoothVelocity = SmoothVelocity:Lerp(moveDir * humanoid.WalkSpeed, 0.22)
            humanoid:Move(SmoothVelocity.Unit * math.min(SmoothVelocity.Magnitude, humanoid.WalkSpeed), false)
        end
    end
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end

    -- กดปุ่ม P เพื่อกดเล่น (Play)
    if input.KeyCode == Enum.KeyCode.P then
        pcall(function()
            FirePlayRemote()
        end)
    end

    -- กดปุ่ม N เพื่อกลับล็อบบี้ (เปลี่ยนจาก M เป็น N)
    if input.KeyCode == Enum.KeyCode.N then
        pcall(function()
            game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("Command"):FireServer("Lobby")
        end)
    end
end)



