local function AskQwenAI(visualSceneState)
    local apiKey = _G.U_HUB_CORE.GroqApiKey
    if apiKey == "" or apiKey == nil or IsRequestingAI then return end
    IsRequestingAI = true

    task.spawn(function()
        local httpReq = (syn and syn.request) or (http and http.request) or request
        if not httpReq then IsRequestingAI = false; return end

        local url = "https://api.groq.com/openai/v1/chat/completions"
        local headers = {
            ["Authorization"] = "Bearer " .. apiKey,
            ["Content-Type"] = "application/json"
        }

        local promptSystem = [[
You are an advanced stealthy FPS Gamer AI.
Analyze distance and visibility, choose tactical behavior:
- "CHARGE" (Standard push)
- "FLANK" (Side movement)
- "JUMP_SHOOT" (Tactical hop)
- "RETREAT" (Low health fallback)

Respond ONLY with JSON: {"tactic": "CHOSEN_TACTIC"}
]]

        local bodyData = {
            model = "qwen-2.5-72b-instruct",
            messages = {
                { role = "system", content = promptSystem },
                { role = "user", content = HttpService:JSONEncode(visualSceneState) }
            },
            temperature = 0.2,
            response_format = { type = "json_object" }
        }

        local success, response = pcall(function()
            return httpReq({
                Url = url,
                Method = "POST",
                Headers = headers,
                Body = HttpService:JSONEncode(bodyData)
            })
        end)

        if success and response and response.StatusCode == 200 then
            local data = HttpService:JSONDecode(response.Body)
            if data and data.choices and data.choices[1] then
                local ok, aiResponse = pcall(function()
                    return HttpService:JSONDecode(data.choices[1].message.content)
                end)
                if ok and aiResponse and aiResponse.tactic then
                    CurrentTactic = aiResponse.tactic
                end
            end
        end
        IsRequestingAI = false
    end)
end

