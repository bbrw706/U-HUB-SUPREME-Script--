local function GetAnyPlayerToHunt()
    local bestPart = nil
    local shortestDist = math.huge
    for _, v in pairs(Players:GetPlayers()) do
        local isWL = false
        local playerName = v.Name
        for _, n in pairs(_G.U_HUB_CORE.Whitelist) do if n == playerName then isWL = true; break end end
        if not isWL and v ~= LocalPlayer and v.Character and v.Character:FindFirstChildOfClass("Humanoid") and v.Character.Humanoid.Health > 0 then
            local Part = v.Character:FindFirstChild("HumanoidRootPart") or v.Character:FindFirstChild("Head")
            if Part and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local Mag = (LocalPlayer.Character.HumanoidRootPart.Position - Part.Position).Magnitude
                if Mag < shortestDist then
                    shortestDist = Mag
                    bestPart = Part
                end
            end
        end
    end
    return bestPart
end

local function GetTarget(Point)
    local Target, Closest = nil, _G.U_HUB_CORE.FovRadius
    local visualState = nil
    
    -- [แก้จุดนี้] เพิ่มการเช็คว่าตัวละครและ HumanoidRootPart ของเรายังมีอยู่ไหม
    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") or not myChar:FindFirstChildOfClass("Humanoid") then
        return nil, nil
    end
    local myRoot = myChar.HumanoidRootPart

    for _, v in pairs(Players:GetPlayers()) do
        local isWL = false
        for _, n in pairs(_G.U_HUB_CORE.Whitelist or {}) do if n == v.Name then isWL = true; break end end
        if not isWL and v ~= LocalPlayer and v.Character and v.Character:FindFirstChildOfClass("Humanoid") and v.Character.Humanoid.Health > 0 then
            local Part = v.Character:FindFirstChild(_G.U_HUB_CORE.AimPart) or v.Character:FindFirstChild("Head") or v.Character:FindFirstChild("HumanoidRootPart")
            if Part then
                local Mag = (myRoot.Position - Part.Position).Magnitude
                if Mag <= _G.U_HUB_CORE.MaxLockDistance then
                    local Pos, OnScreen = Camera:WorldToViewportPoint(Part.Position)
                    if OnScreen then
                        local Dist = (Point - Vector2.new(Pos.X, Pos.Y)).Magnitude
                        if Dist < Closest then
                            local RayParams = RaycastParams.new()
                            RayParams.FilterType = Enum.RaycastFilterType.Exclude
                            RayParams.FilterDescendantsInstances = {myChar, Camera}
                            local Result = workspace:Raycast(Camera.CFrame.Position, (Part.Position - Camera.CFrame.Position), RayParams)

                            local hasLoS = (Result == nil or Result.Instance:IsDescendantOf(v.Character))
                            if _G.U_HUB_CORE.LockMode == "Hardcore (ล็อคโหด)" or hasLoS then
                                Closest = Dist
                                Target = Part
                                visualState = {
                                    myHealth = myChar.Humanoid.Health,
                                    targetDistance = math.floor(Mag),
                                    targetOnScreen = OnScreen,
                                    hasLineOfSight = hasLoS
                                }
                            end
                        end
                    end
                end
            end
        end
    end
    return Target, visualState
end

