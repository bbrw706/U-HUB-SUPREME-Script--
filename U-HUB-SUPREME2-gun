local LastShootTime = 0
local LastPosition = Vector3.new(0,0,0)
local StuckTimer = 0
local RoamAngle = 0
local SmoothVelocity = Vector3.new(0,0,0)

RunService.RenderStepped:Connect(function(dt)
    local Center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    
    if _G.FOV_CircleFrame then
        local isLockActive = _G.U_HUB_CORE.AutoLockNoClick or _G.U_HUB_CORE.AutoFarmEnabled
        _G.FOV_CircleFrame.Visible = _G.U_HUB_CORE.FovEnabled and isLockActive
        _G.FOV_CircleFrame.Size = UDim2.fromOffset(_G.U_HUB_CORE.FovRadius * 2, _G.U_HUB_CORE.FovRadius * 2)
        _G.FOV_CircleFrame.Position = UDim2.fromOffset(Center.X, Center.Y)
        _G.FOV_Stroke.Color = _G.U_HUB_CORE.PovColor
    end

    local LockTarget = nil
    local visualState = nil

    if _G.U_HUB_CORE.AutoLockNoClick then
        LockTarget, visualState = GetTarget(Center)
    end

    if _G.U_HUB_CORE.AutoFarmEnabled and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local autoTargetPart, autoState = GetClosestTargetAuto()
        local humanoid = LocalPlayer.Character.Humanoid
        local root = LocalPlayer.Character.HumanoidRootPart

        local destinationPos = nil

        if autoTargetPart then
            LockTarget = autoTargetPart
            visualState = autoState

            if autoState and autoState.hasLineOfSight then
                local randomDelay = math.random(15, 30) / 100
                if tick() - LastShootTime > randomDelay then
                    LastShootTime = tick()
                    SafeHumanClick()
                end
            end

            local targetRoot = autoTargetPart.Parent:FindFirstChild("HumanoidRootPart") or autoTargetPart
            destinationPos = targetRoot.Position
            local currentRadius = math.clamp(_G.U_HUB_CORE.AiWalkRadius, 5, 50)

            if CurrentTactic == "FLANK" then
                destinationPos = targetRoot.Position + (targetRoot.CFrame.RightVector * currentRadius)
            elseif CurrentTactic == "JUMP_SHOOT" then
                if math.random(1, 25) == 1 and humanoid.FloorMaterial ~= Enum.Material.Air then
                    humanoid.Jump = true
                end
                destinationPos = targetRoot.Position + (targetRoot.CFrame.RightVector * (math.random(-1, 1) * 12))
            elseif CurrentTactic == "RETREAT" then
                destinationPos = root.Position + (root.Position - targetRoot.Position).Unit * 25
            end
        else
            local huntTarget = GetAnyPlayerToHunt()
            if huntTarget then
                destinationPos = huntTarget.Position
            else
                RoamAngle = RoamAngle + 1.2 * dt
                local offset = Vector3.new(math.cos(RoamAngle) * 40, 0, math.sin(RoamAngle) * 40)
                destinationPos = root.Position + offset
            end
        end

        if (root.Position - LastPosition).Magnitude < 0.3 then
            StuckTimer = StuckTimer + dt
            if StuckTimer > 0.3 then
                humanoid.Jump = true
                destinationPos = root.Position + Vector3.new(math.random(-40, 40), 0, math.random(-40, 40))
                StuckTimer = 0
            end
        else
            StuckTimer = 0
        end
        LastPosition = root.Position

        if destinationPos then
            local moveDir = (destinationPos - root.Position)
            moveDir = Vector3.new(moveDir.X, 0, moveDir.Z)
            
            if moveDir.Magnitude > 0.1 then
                moveDir = moveDir.Unit
                local rayParams = RaycastParams.new()
                rayParams.FilterType = Enum.RaycastFilterType.Exclude
                rayParams.FilterDescendantsInstances = {LocalPlayer.Character, Camera}

                local checkDist = 6
                local hitCenter = workspace:Raycast(root.Position, moveDir * checkDist, rayParams)
                local leftDir = CFrame.Angles(0, math.rad(-45), 0) * moveDir
                local hitLeft = workspace:Raycast(root.Position, leftDir * checkDist, rayParams)
                local rightDir = CFrame.Angles(0, math.rad(45), 0) * moveDir
                local hitRight = workspace:Raycast(root.Position, rightDir * checkDist, rayParams)

                if hitCenter then
                    humanoid.Jump = true
                    if not hitLeft then
                        moveDir = leftDir
                    elseif not hitRight then
                        moveDir = rightDir
                    else
                        moveDir = -moveDir
                    end
                end

                SmoothVelocity = SmoothVelocity:Lerp(moveDir * humanoid.WalkSpeed, 0.2)
                humanoid:Move(SmoothVelocity.Unit * math.min(SmoothVelocity.Magnitude, humanoid.WalkSpeed), false)
            end
        end
    end

    if LockTarget then
        local jitter = Vector3.new(math.random(-10, 10)/100, math.random(-10, 10)/100, 0)
        local TargetCF = CFrame.new(Camera.CFrame.Position, LockTarget.Position + jitter)
        local currentSens = _G.U_HUB_CORE.AutoFarmEnabled and _G.U_HUB_CORE.AiSmoothness or _G.U_HUB_CORE.Sensitivity
        Camera.CFrame = Camera.CFrame:Lerp(TargetCF, currentSens)
    end

    -- ESP SYSTEM
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local dist = (LocalPlayer.Character.HumanoidRootPart.Position - player.Character.HumanoidRootPart.Position).Magnitude
            
            if dist <= _G.U_HUB_CORE.MaxEspDistance then
                local hl = player.Character:FindFirstChild("U_ESP")
                if _G.U_HUB_CORE.EspStyle ~= "ปิด" then
                    if not hl then hl = Instance.new("Highlight", player.Character); hl.Name = "U_ESP" end
                    hl.FillTransparency = (_G.U_HUB_CORE.EspStyle == "Hardcore (เรืองแสง)" and 0.5 or 1)
                    hl.OutlineColor = _G.U_HUB_CORE.SharedColor
                elseif hl then hl:Destroy() end
                
                local head = player.Character:FindFirstChild("Head")
                if head then
                    local b = head:FindFirstChild("U_B")
                    if _G.U_HUB_CORE.ShowName or _G.U_HUB_CORE.ShowDistance then
                        if not b then
                            b = Instance.new("BillboardGui", head); b.Name = "U_B"; b.Size = UDim2.new(0,100,0,50); b.AlwaysOnTop = true; b.StudsOffset = Vector3.new(0,2,0)
                            local l = Instance.new("TextLabel", b); l.Size = UDim2.new(1,0,1,0); l.BackgroundTransparency = 1; l.Font = "GothamBold"; l.TextSize = 14; l.OutlineAlpha = 1
                        end
                        b.TextLabel.Text = (_G.U_HUB_CORE.ShowName and player.Name or "") .. (_G.U_HUB_CORE.ShowDistance and "\n["..math.floor(dist).."m]" or "")
                        b.TextLabel.TextColor3 = _G.U_HUB_CORE.MyCustomTextColor
                    elseif b then b:Destroy() end
                end
            else
                if player.Character:FindFirstChild("U_ESP") then player.Character.U_ESP:Destroy() end
                if player.Character:FindFirstChild("Head") and player.Character.Head:FindFirstChild("U_B") then player.Character.Head.U_B:Destroy() end
            end
        end
    end
end)
