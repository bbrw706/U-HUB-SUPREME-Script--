-- [[ SAFE SHOOT: ส่งไปเซิร์ฟว่าคลิกซ้าย + รองรับ PC/มือถือ ]]
local CachedShootRemotes = nil
local LastRemoteScan = 0
local CurrentHuntTarget = nil

local function ScanShootRemotes()
    local found = {}
    local keywords = {
        "shoot", "fire", "shot", "bullet", "gun", "weapon", "attack",
        "click", "mouse", "input", "combat", "damage", "hit",
        "muzzle", "projectile", "pew"
    }
    pcall(function()
        local function scan(parent, depth)
            if depth > 4 or not parent then return end
            for _, obj in ipairs(parent:GetChildren()) do
                local nameLower = string.lower(obj.Name)
                local match = false
                for _, kw in ipairs(keywords) do
                    if string.find(nameLower, kw, 1, true) then
                        match = true
                        break
                    end
                end
                if match and (obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") or obj:IsA("UnreliableRemoteEvent")) then
                    table.insert(found, obj)
                end
                if obj:IsA("Folder") or obj:IsA("Configuration") or obj.Name == "Remotes" then
                    scan(obj, depth + 1)
                end
            end
        end
        scan(game:GetService("ReplicatedStorage"), 0)
        local char = LocalPlayer.Character
        if char then
            for _, tool in ipairs(char:GetChildren()) do
                if tool:IsA("Tool") then
                    scan(tool, 0)
                end
            end
        end
    end)
    return found
end

local function FireShootToServer()
    -- 1) Tool:Activate (เกมส่วนใหญ่ฟังแล้วส่ง remote เอง)
    pcall(function()
        local char = LocalPlayer.Character
        if not char then return end
        local tool = char:FindFirstChildOfClass("Tool")
        if tool then
            tool:Activate()
            for _, rem in ipairs(tool:GetDescendants()) do
                if rem:IsA("RemoteEvent") or rem:IsA("UnreliableRemoteEvent") then
                    pcall(function() rem:FireServer() end)
                    pcall(function() rem:FireServer(true) end)
                    pcall(function() rem:FireServer("Shoot") end)
                    pcall(function() rem:FireServer(1) end)
                elseif rem:IsA("RemoteFunction") then
                    pcall(function() rem:InvokeServer() end)
                end
            end
        end
    end)

    -- 2) Virtual mouse click (PC + executor)
    pcall(function()
        if mouse1click then
            mouse1click()
        elseif pressmouse1 then
            pressmouse1()
        elseif mouse1press and mouse1release then
            mouse1press()
            task.wait(0.03)
            mouse1release()
        end
    end)

    -- 3) สแกน Remote ที่เกี่ยวกับยิง แล้ว FireServer
    if not CachedShootRemotes or (tick() - LastRemoteScan) > 8 then
        CachedShootRemotes = ScanShootRemotes()
        LastRemoteScan = tick()
    end
    for _, rem in ipairs(CachedShootRemotes or {}) do
        pcall(function()
            if rem:IsA("RemoteEvent") or rem:IsA("UnreliableRemoteEvent") then
                rem:FireServer()
                rem:FireServer(true)
                rem:FireServer("Shoot")
                rem:FireServer("Fire")
                rem:FireServer(1)
                local tgt = CurrentHuntTarget
                if tgt and typeof(tgt) == "Instance" and tgt:IsA("BasePart") then
                    rem:FireServer(tgt.Position)
                    rem:FireServer(tgt)
                end
            elseif rem:IsA("RemoteFunction") then
                rem:InvokeServer()
                rem:InvokeServer(true)
            end
        end)
    end

    -- 4) ชื่อ remote ทั่วไปใน ReplicatedStorage.Remotes
    pcall(function()
        local remotes = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes")
        if not remotes then return end
        for _, name in ipairs({"Shoot", "Fire", "GunShoot", "WeaponFire", "Attack", "Combat", "Click", "MouseClick", "Input"}) do
            local rem = remotes:FindFirstChild(name)
            if rem then
                if rem:IsA("RemoteEvent") or rem:IsA("UnreliableRemoteEvent") then
                    pcall(function() rem:FireServer() end)
                    pcall(function() rem:FireServer(true) end)
                elseif rem:IsA("RemoteFunction") then
                    pcall(function() rem:InvokeServer() end)
                end
            end
        end
    end)
end

