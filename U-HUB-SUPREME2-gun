-- ฟังก์ชันกลางสำหรับยิงรีโมท Play แบบครอบคลุมทุกชื่อ
local function FirePlayRemote()
    pcall(function()
        local remotes = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes")
        if remotes then
            for _, remName in ipairs({"Command", "RemoteFunction", "RemoteEvent", "Event", "Function", "Play", "Spawn"}) do
                local rem = remotes:FindFirstChild(remName)
                if rem then
                    if rem:IsA("RemoteEvent") then
                        rem:FireServer("Play")
                        rem:FireServer("Spawn")
                    elseif rem.ClassName == "RemoteFunction" then
                        pcall(function() rem:InvokeServer("Play") end)
                    end
                end
            end
        end
        game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("Command"):FireServer("Play")
    end)
end

