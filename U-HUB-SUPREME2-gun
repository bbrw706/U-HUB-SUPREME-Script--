-- ESP SYSTEM
-- ============================================================
local EspCache = {}

local function RemoveEsp(player)
    if EspCache[player] then
        if EspCache[player].Box then EspCache[player].Box:Remove() end
        if EspCache[player].Line then EspCache[player].Line:Remove() end
        if EspCache[player].NameText then EspCache[player].NameText:Remove() end
        EspCache[player] = nil
    end
end

RunService.RenderStepped:Connect(function()
    local espStyle = _G.U_HUB_CORE.EspStyle

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            local humanoid = char and char:FindFirstChildOfClass("Humanoid")
            local rootPart = char and char:FindFirstChild("HumanoidRootPart")

            local isWL = false
            for _, n in pairs(_G.U_HUB_CORE.Whitelist or {}) do
                if n == player.Name then isWL = true; break end
            end

            if espStyle ~= "ปิด" and not isWL and char and humanoid and humanoid.Health > 0 and rootPart then
                if not PlayerSpawnTimes[player] then
                    PlayerSpawnTimes[player] = tick()
                end
                local isImmune = (tick() - PlayerSpawnTimes[player]) < 1.0

                local myChar = LocalPlayer.Character
                local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                local mag = myRoot and (myRoot.Position - rootPart.Position).Magnitude or 0

                if mag <= (_G.U_HUB_CORE.MaxEspDistance or 1500) then
                    local head = char:FindFirstChild("Head")
                    if head then
                        local headPos, headOnScreen = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
                        local legPos = Camera:WorldToViewportPoint(rootPart.Position - Vector3.new(0, 3, 0))

                        if headOnScreen then
                            if not EspCache[player] then
                                local box = Drawing.new("Square")
                                box.Visible = false
                                box.Filled = false
                                box.Thickness = 1
                                local line = Drawing.new("Line")
                                line.Visible = false
                                line.Thickness = 1
                                local nameText = Drawing.new("Text")
                                nameText.Visible = false
                                nameText.Center = true
                                nameText.Size = 13
                                nameText.Outline = true
                                EspCache[player] = { Box = box, Line = line, NameText = nameText }
                            end

                            local cache = EspCache[player]
                            local height = math.abs(headPos.Y - legPos.Y)
                            local width = height / 2
                            cache.Box.Size = Vector2.new(width, height)
                            cache.Box.Position = Vector2.new(headPos.X - width / 2, headPos.Y)

                            local targetColor = isImmune and Color3.fromRGB(255, 0, 0) or Color3.fromRGB(0, 255, 0)
                            cache.Box.Color = targetColor

                            if espStyle == "กล้อง" then
                                cache.Box.Visible = true
                                cache.Line.Visible = false
                            elseif espStyle == "กล้อง+เส้น" then
                                cache.Box.Visible = true
                                cache.Line.Visible = true
                                cache.Line.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                                cache.Line.To = Vector2.new(headPos.X, headPos.Y)
                                cache.Line.Color = targetColor
                            else
                                cache.Box.Visible = false
                                cache.Line.Visible = false
                            end

                            local infoStr = ""
                            if isImmune then
                                infoStr = player.Name .. " (ยังยิงไม่ได้)"
                            else
                                if _G.U_HUB_CORE.ShowName then infoStr = player.Name end
                                if _G.U_HUB_CORE.ShowDistance then
                                    infoStr = infoStr .. (infoStr ~= "" and " " or "") .. "[" .. math.floor(mag) .. "m]"
                                end
                            end

                            if infoStr ~= "" then
                                cache.NameText.Text = infoStr
                                cache.NameText.Position = Vector2.new(headPos.X, headPos.Y - 18)
                                cache.NameText.Color = isImmune and Color3.fromRGB(255, 100, 100) or _G.U_HUB_CORE.MyCustomTextColor
                                cache.NameText.Visible = true
                            else
                                cache.NameText.Visible = false
                            end
                        else
                            if EspCache[player] then
                                EspCache[player].Box.Visible = false
                                EspCache[player].Line.Visible = false
                                EspCache[player].NameText.Visible = false
                            end
                        end
                    end
                else
                    if EspCache[player] then
                        EspCache[player].Box.Visible = false
                        EspCache[player].Line.Visible = false
                        EspCache[player].NameText.Visible = false
                    end
                end
            else
                RemoveEsp(player)
            end
        end
    end
end)

local function HookPlayer(player)
    player.CharacterAdded:Connect(function(char)
        PlayerSpawnTimes[player] = tick()
        local humanoid = char:WaitForChild("Humanoid", 5)
        if humanoid then
            humanoid.Died:Connect(function()
                PlayerSpawnTimes[player] = tick()
            end)
        end
    end)
    if player.Character then
        local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid.Died:Connect(function()
                PlayerSpawnTimes[player] = tick()
            end)
        end
    end
end

for _, p in pairs(Players:GetPlayers()) do
    if p ~= LocalPlayer then HookPlayer(p) end
end
Players.PlayerAdded:Connect(HookPlayer)
Players.PlayerRemoving:Connect(RemoveEsp)

