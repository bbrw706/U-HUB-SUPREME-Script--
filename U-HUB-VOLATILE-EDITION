	local d1 = (hrp.Position - part1.Position).Magnitude
	local d2 = (hrp.Position - part2.Position).Magnitude
	local d3 = (hrp.Position - part3.Position).Magnitude

	if d1 <= d2 and d1 <= d3 then
		return 1
	elseif d2 <= d1 and d2 <= d3 then
		return 2
	else
		return 3
	end
end

