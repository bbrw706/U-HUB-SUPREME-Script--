-- [[ 1. Linear Flight Function (Locked Orientation) ]]
local function flyTo(targetCF)
    local char = lp.Character or lp.CharacterAdded:Wait()
    local hrp = char:WaitForChild("HumanoidRootPart")
    flying = true

    -- NoClip & Anti-Fling System
    local nc = RunService.Stepped:Connect(function()
        if flying then
            for _, v in pairs(char:GetDescendants()) do
                if v:IsA("BasePart") then v.CanCollide = false end
            end
            hrp.Velocity = Vector3.zero
            hrp.RotVelocity = Vector3.zero
        end
    end)

    local dist = (hrp.Position - targetCF.Position).Magnitude
    -- Flight execution with Matrix-aligned CFrame
    local tween = TweenService:Create(hrp, TweenInfo.new(dist / _G.FlySpeed, Enum.EasingStyle.Linear), {CFrame = targetCF})
    
    tween:Play()
    tween.Completed:Wait()

    nc:Disconnect()
    flying = false
    task.wait(0.01) -- Cooldown
end

