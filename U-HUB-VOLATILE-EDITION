    local Pos3 = finalTarget -- Destination Zone

    -- 1 -> 2 -> 3 Flight Sequence
    flyTo(Pos1)
    flyTo(Pos2)
    flyTo(Pos3)

    -- Restore Collision
    for _, v in pairs(lp.Character:GetDescendants()) do
        if v:IsA("BasePart") then v.CanCollide = true end
    end
end

