local function getClosestZoneIndex()
    local char = lp.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return 1 end

    local closestDist = math.huge
    local closestIndex = 1

    for i = 1, #Locations do
        local dist = (hrp.Position - Locations[i].Position).Magnitude
        if dist < closestDist then
            closestDist = dist
            closestIndex = i
        end
    end
    return closestIndex
end

-- Warp Function (Speed Safety Check)
local function WarpTo(target)
    local char = lp.Character or lp.CharacterAdded:Wait()
    local hrp = char:WaitForChild("HumanoidRootPart", 5)
    local speed = _G.FlySpeed or 400 
    
    if hrp then
        for _, v in pairs(char:GetChildren()) do if v:IsA("BasePart") then v.CanCollide = false end end
        local dist = (hrp.Position - target.Position).Magnitude
        local tween = game:GetService("TweenService"):Create(hrp, TweenInfo.new(dist / speed, Enum.EasingStyle.Linear), {CFrame = target})
        tween:Play()
        tween.Completed:Wait()
        for _, v in pairs(char:GetChildren()) do if v:IsA("BasePart") then v.CanCollide = true end end
    end
end

